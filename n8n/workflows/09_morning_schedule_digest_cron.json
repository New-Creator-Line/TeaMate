{
  "id": "kM9MorningDigest09",
  "name": "09_Morning_Schedule_Digest_Cron",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Moscow"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Cron 09:00 MSK Weekdays",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 260],
      "id": "node-morning-cron"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-gateway:8080/api/notifications/dispatch/morning-digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Service-Key",
              "value": "fotoprint-internal-service-secret-token-2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"enforce_schedule_time\": true}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "name": "Dispatch Morning Digest (Cron)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 260],
      "id": "node-morning-dispatch-cron"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-morning-digest",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Manual Morning Digest Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 480],
      "id": "node-morning-webhook",
      "webhookId": "manual-morning-digest"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-gateway:8080/api/notifications/dispatch/morning-digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Service-Key",
              "value": "fotoprint-internal-service-secret-token-2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || {}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "name": "Dispatch Morning Digest (Manual)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 480],
      "id": "node-morning-dispatch-manual"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "name": "Return Morning Digest Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 480],
      "id": "node-morning-respond"
    }
  ],
  "connections": {
    "Cron 09:00 MSK Weekdays": {
      "main": [
        [
          {
            "node": "Dispatch Morning Digest (Cron)",
